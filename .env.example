# Database
POSTGRES_USER=ruesselsheim_bot
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ruesselsheim_chatbot
DATABASE_URL=postgresql://ruesselsheim_bot:change_me_in_production@postgres:5432/ruesselsheim_chatbot

# Anthropic API (REQUIRED - for chat responses)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (OPTIONAL - only needed if using OpenAI embeddings)
# Leave empty or remove if using local embeddings
OPENAI_API_KEY=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Embeddings Configuration
# Choose "local" (no API key needed) or "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# For local embeddings (default, no API key needed)
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DIM=384

# For OpenAI embeddings (requires OPENAI_API_KEY)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Vector DB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
