# Database
POSTGRES_USER=ruesselsheim_bot
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ruesselsheim_chatbot
DATABASE_URL=postgresql://ruesselsheim_bot:change_me_in_production@postgres:5432/ruesselsheim_chatbot

# ============================================
# LLM PROVIDER - Choose one:
# ============================================
# "ollama"  = 100% FREE, LOCAL - no API key needed, runs on your Mac (recommended)
# "gemini"  = FREE (Google Gemini) - requires free API key
# "claude"  = PAID (Anthropic Claude) - best quality but costs money
LLM_PROVIDER=ollama

# Ollama Configuration (ONLY if LLM_PROVIDER=ollama)
# Requires Ollama installed: https://ollama.ai
# Install model: ollama pull llama3.1:8b
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Google Gemini API (ONLY if LLM_PROVIDER=gemini)
# Get free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic API (ONLY if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# ============================================
# EMBEDDINGS - Choose one:
# ============================================
# OpenAI API (OPTIONAL - only needed if using OpenAI embeddings)
# Leave empty to use FREE local embeddings
OPENAI_API_KEY=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Embeddings Configuration
# Choose "local" (no API key needed) or "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# For local embeddings (default, no API key needed)
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DIM=384

# For OpenAI embeddings (requires OPENAI_API_KEY)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Vector DB
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
